<div class="cqb-shell">
  <header class="cqb-header">
    <div class="cqb-crest" aria-hidden="true">
      <i class="fa-solid fa-dragon"></i>
    </div>

    <div class="cqb-heading">
      <p class="cqb-kicker">CRIMSON TYRANT <span class="cqb-divider">//</span> CHARTERS &amp; RUMOURS</p>
      <h1>{{#if isForm}}{{#if draft.id}}Amend the charter{{else}}Inscribe a charter{{/if}}{{else}}The Crimson Board{{/if}}</h1>
      <p class="cqb-sub">
        {{#if isForm}}Set the terms, name the price, and seal it for the guild.
        {{else}}Charters, bounties and ugly rumours, nailed up for those bold enough to take them.
        {{/if}}
      </p>
      {{#unless isForm}}
      <p class="cqb-sig">
        <span class="cqb-sig-dot" aria-hidden="true"></span>
        WARD STABLE <span class="cqb-divider">//</span> {{totalCount}} CHARTERS <span class="cqb-divider">//</span> {{roleLabel}}
      </p>
      {{/unless}}
    </div>

    <div class="cqb-header-actions">
      {{#if isGM}}
        {{#if isForm}}
        <button type="button" class="cqb-button cqb-button--ghost" data-action="cancelQuest"><i class="fa-solid fa-arrow-left"></i> Back to the board</button>
        {{else}}
        <button type="button" class="cqb-button cqb-button--primary" data-action="newQuest"><i class="fa-solid fa-feather-pointed"></i> Post a charter</button>
        {{/if}}
      {{/if}}
    </div>
  </header>

  {{#unless isForm}}
  <div class="cqb-toolbar">
    <div class="cqb-chips" role="tablist" aria-label="Charter sections">
      {{#each tabs}}
      <button type="button" class="cqb-chip {{#if active}}is-active{{/if}}" data-action="selectTab" data-tab="{{id}}" role="tab" aria-selected="{{#if active}}true{{else}}false{{/if}}">
        {{label}} <b>{{count}}</b>
      </button>
      {{/each}}
    </div>

    <label class="cqb-search">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input type="search" data-quest-search value="{{filters.search}}" placeholder="Search the board..." aria-label="Search charters">
    </label>

    <label class="cqb-kind">
      <span>KIND</span>
      <select data-quest-type aria-label="Filter by kind">
        {{#each types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>

    <button type="button" class="cqb-button cqb-button--ghost cqb-clear" data-action="clearQuestFilters" title="Clear filters" aria-label="Clear filters"><i class="fa-solid fa-filter-circle-xmark"></i></button>
  </div>
  {{/unless}}

  <main class="cqb-body">
    {{#if isForm}}
    <section class="cqb-charter-sheet">
      <header class="cqb-sheet-head">
        <p class="cqb-kicker">GUILD OF THE SCARLET WING <span class="cqb-divider">//</span> CHARTER OF ENGAGEMENT</p>
        <h2>{{#if draft.id}}Amend the posting{{else}}A new posting for the board{{/if}}</h2>
        <p>Write what the guild knows. Leave the sealed notes for the Guildmaster's eyes.</p>
      </header>

      <form data-quest-form autocomplete="off">
        <div class="cqb-form-grid">
          <label class="cqb-field cqb-field--wide">Title
            <input name="title" value="{{draft.title}}" maxlength="120" placeholder="A name the whole table will remember" required>
          </label>
          <label class="cqb-field">Kind
            <select name="type">
              {{#each formTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
          <label class="cqb-field">Danger
            <input name="danger" type="number" min="1" max="5" step="1" value="{{draft.danger}}">
          </label>
          <label class="cqb-field">Patron
            <input name="patron" value="{{draft.patron}}" maxlength="120" placeholder="Who is paying?">
          </label>
          <label class="cqb-field">Location
            <input name="location" value="{{draft.location}}" maxlength="120" placeholder="Where does it happen?">
          </label>
          <label class="cqb-field">Bounty (gp)
            <input name="reward" type="number" min="0" step="1" value="{{draft.reward}}">
          </label>
          <label class="cqb-field">Also offered
            <input name="rewardNote" value="{{draft.rewardNote}}" maxlength="160" placeholder="A favour, a title, a secret...">
          </label>
          <label class="cqb-field cqb-field--wide">The brief
            <textarea name="summary" rows="3" maxlength="1000" placeholder="What the players will hear at the board.">{{draft.summary}}</textarea>
          </label>
          <label class="cqb-field cqb-field--wide">Objectives
            <textarea name="objectives" rows="4" maxlength="2400" placeholder="One objective per line.">{{draft.objectives}}</textarea>
          </label>
          <label class="cqb-field cqb-field--wide">Tags
            <input name="tags" value="{{draft.tags}}" maxlength="400" placeholder="hunt, village, missing">
          </label>
          {{#if isGM}}
          <label class="cqb-field cqb-field--wide cqb-gm-field">Sealed notes
            <textarea name="gmNotes" rows="3" maxlength="3000" placeholder="Only the Guildmaster sees this.">{{draft.gmNotes}}</textarea>
          </label>
          <label class="cqb-check">
            <input name="published" type="checkbox" {{#if draft.published}}checked{{/if}}>
            <span>Publish to the sworn hunters</span>
          </label>
          {{/if}}
        </div>

        {{#if error}}<p class="cqb-error" role="alert">{{error}}</p>{{/if}}

        <footer class="cqb-form-footer">
          <button type="button" class="cqb-button cqb-button--ghost" data-action="cancelQuest">Cancel</button>
          <button type="button" class="cqb-button cqb-button--primary" data-action="saveQuest"><i class="fa-solid fa-seal"></i> Seal the charter</button>
        </footer>
      </form>
    </section>
    {{else}}
      {{#if noJournal}}
      <div class="cqb-empty">
        <i class="fa-solid fa-scroll" aria-hidden="true"></i>
        <h2>The board is not posted yet</h2>
        <p>{{#if isGM}}A Guildmaster can reopen the board to create the shared journal, or check that the Crimson Board journal exists.{{else}}The Guildmaster has not put up the Crimson Board in this world yet.{{/if}}</p>
      </div>
      {{else if quests.length}}
      <div class="cqb-grid">
        {{#each quests}}
        <article class="cqb-card {{statusClass}}" data-quest-id="{{id}}">
          <span class="cqb-nail cqb-nail--left" aria-hidden="true"></span>
          <span class="cqb-nail cqb-nail--right" aria-hidden="true"></span>
          <span class="cqb-wax {{statusClass}}" title="{{statusLabel}}" aria-label="{{statusLabel}}"><span>{{sealLabel}}</span></span>

          <header class="cqb-card-top">
            <span class="cqb-type"><i class="{{typeIcon}}" aria-hidden="true"></i> {{typeLabel}}</span>
            {{#unless published}}<span class="cqb-draft">Draft</span>{{/unless}}
            {{#if createdLabel}}<span class="cqb-posted">Nailed {{createdLabel}}</span>{{/if}}
          </header>

          <h2>{{title}}</h2>

          {{#if summary}}<p class="cqb-summary">{{summary}}</p>{{/if}}

          <dl class="cqb-ledger">
            {{#if patron}}<div><dt>PATRON</dt><dd>{{patron}}</dd></div>{{/if}}
            {{#if location}}<div><dt>LOCATION</dt><dd>{{location}}</dd></div>{{/if}}
            <div><dt>BOUNTY</dt><dd class="cqb-reward">{{rewardLabel}} gp{{#if rewardNote}}<small>{{rewardNote}}</small>{{/if}}</dd></div>
          </dl>

          <div class="cqb-card-mid">
            <span class="cqb-danger" title="Danger {{danger}} of 5" aria-label="Danger {{danger}} of 5">
              <small>DANGER</small>
              <span class="cqb-claws" aria-hidden="true">
                {{#each dangerPips}}<i class="cqb-claw {{#if filled}}is-full{{/if}}"></i>{{/each}}
              </span>
            </span>
            <span class="cqb-status {{statusClass}}">{{statusLabel}}</span>
            {{#if claimedBy}}<span class="cqb-claimed"><i class="fa-solid fa-hand" aria-hidden="true"></i> {{claimedBy}}</span>{{/if}}
          </div>

          <details class="cqb-charter">
            <summary>
              <span>Read the charter</span>
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </summary>
            <div class="cqb-charter-body">
              {{#if objectives}}<div class="cqb-objectives">{{objectives}}</div>{{/if}}
              {{#if tags.length}}<p class="cqb-tagline">{{#each tags}}<span>{{this}}</span>{{/each}}</p>{{/if}}
              {{#if @root.isGM}}
                {{#if gmNotes}}<div class="cqb-gm-note"><strong>SEALED NOTES</strong><p>{{gmNotes}}</p></div>{{/if}}
              {{/if}}
            </div>
          </details>

          <footer class="cqb-card-actions">
            {{#if canClaim}}<button type="button" class="cqb-button cqb-button--primary" data-action="claimQuest" data-quest-id="{{id}}"><i class="fa-solid fa-hand"></i> Claim charter</button>{{/if}}
            {{#if canRelease}}<button type="button" class="cqb-button cqb-button--ghost" data-action="releaseQuest" data-quest-id="{{id}}"><i class="fa-solid fa-rotate-left"></i> {{#if isMine}}Release my claim{{else}}Release{{/if}}</button>{{/if}}
            {{#if @root.isGM}}
              <button type="button" class="cqb-icon-button" data-action="editQuest" data-quest-id="{{id}}" title="Amend charter"><i class="fa-solid fa-pen"></i></button>
              {{#if published}}<button type="button" class="cqb-icon-button" data-action="unpublishQuest" data-quest-id="{{id}}" title="Hide from players"><i class="fa-solid fa-eye-slash"></i></button>{{else}}<button type="button" class="cqb-icon-button" data-action="publishQuest" data-quest-id="{{id}}" title="Publish to players"><i class="fa-solid fa-eye"></i></button>{{/if}}
              {{#if canComplete}}
                <button type="button" class="cqb-icon-button" data-action="completeQuest" data-quest-id="{{id}}" title="Mark fulfilled"><i class="fa-solid fa-check"></i></button>
                <button type="button" class="cqb-icon-button" data-action="failQuest" data-quest-id="{{id}}" title="Mark forfeit"><i class="fa-solid fa-xmark"></i></button>
              {{/if}}
              {{#if canReopen}}
                <button type="button" class="cqb-icon-button" data-action="reopenQuest" data-quest-id="{{id}}" title="Reopen charter"><i class="fa-solid fa-rotate-left"></i></button>
              {{/if}}
              <button type="button" class="cqb-icon-button cqb-danger-button" data-action="deleteQuest" data-quest-id="{{id}}" title="Tear down charter"><i class="fa-solid fa-trash"></i></button>
            {{/if}}
          </footer>
        </article>
        {{/each}}
      </div>
      {{else}}
      <div class="cqb-empty">
        <i class="fa-solid fa-dragon" aria-hidden="true"></i>
        <h2>No charters match</h2>
        <p>Try another ledger tab, clear the filters, or wait for the next rumour to reach the board.</p>
      </div>
      {{/if}}
    {{/if}}
  </main>

  <footer class="cqb-footer">
    <span class="cqb-foot-status"><i class="fa-solid fa-dragon" aria-hidden="true"></i> {{counts.open}} OPEN <span class="cqb-divider">//</span> {{counts.claimed}} BOUND <span class="cqb-divider">//</span> {{counts.done}} ARCHIVED</span>
    {{#if isGM}}<span>GUILDMASTER'S VIEW <span class="cqb-divider">//</span> SEALED NOTES VISIBLE</span>{{else}}<span>CLAIMS ARE WITNESSED BY THE GUILDMASTER</span>{{/if}}
  </footer>
</div>
