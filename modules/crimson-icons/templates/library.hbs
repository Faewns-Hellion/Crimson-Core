<section class="ci-shell"><header><div><small>CRIMSON LIBRARY</small><h2>Icons</h2></div><span>{{total}} icons</span></header><div class="ci-tools"><input name="search" aria-label="Search icons" value="{{query}}" placeholder="Search fire, sword, dragon…"><select name="folder" aria-label="Icon folder">{{#each folders}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div><p class="ci-help">Drag an icon onto an editable image slot. Drop targets glow red. Click an icon to copy its path.</p><p class="ci-count">{{count}} matches · 90 per page</p><div class="ci-grid">{{#each icons}}<button type="button" draggable="true" data-icon="{{path}}" data-action="copy" title="{{label}} — drag to an image slot" aria-label="{{label}}"><img src="{{path}}" loading="lazy" draggable="false" alt="{{label}}"></button>{{else}}<p>No matching icons. Try another search.</p>{{/each}}</div><footer><button type="button" data-action="previous" {{#if first}}disabled{{/if}}>← Previous</button><span>{{page}} / {{pages}}</span><button type="button" data-action="next" {{#if last}}disabled{{/if}}>Next →</button></footer></section>
